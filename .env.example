# ============================================
# DATABASE
# ============================================
# DATABASE_URL — rol admin (BYPASSRLS). Migraciones, webhooks, scripts.
DATABASE_URL="postgresql://sanluca_user:sanluca_pass@localhost:5432/sanluca_db?schema=public"
# DATABASE_URL_APP — rol app (RLS aplica). Runtime web.
DATABASE_URL_APP="postgresql://sanluca_app:<random>@localhost:5432/sanluca_db?schema=public"

# Secret de sesión (HMAC firmado de cookie). Genera con: openssl rand -base64 32
AUTH_SECRET=""

# ============================================
# NEXT.JS
# ============================================
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ============================================
# WHATSAPP (placeholder)
# ============================================
NEXT_PUBLIC_WHATSAPP_BASE_URL="https://wa.me"


# ============================================
# MERCADOPAGO (apartado de fechas especiales)
# ============================================
# Sandbox: TEST-... | Producción: APP_USR-...
MERCADOPAGO_ACCESS_TOKEN=""

# ============================================
# OPENAI (auto-tagging LLM — fase 2 de tags)
# ============================================
# Required by lib/openaiClient.ts. Sin esta clave, el cron de auto-tagging
# falla en el pase LLM (rules pass sigue funcionando). Modelo usado:
# gpt-4o-mini con Structured Outputs. Costo estimado ~$5/mes.
OPENAI_API_KEY="sk-proj-XXXXXXXX"

# ============================================
# CORREO (Resend)
# ============================================
# Requeridas por lib/email.ts. Sin ellas, en producción el envío LANZA y el
# llamador lo registra — es intencional: antes fingía éxito y el correo de
# confirmación de baja de cuenta (LFPDPPP §VI) nunca llegaba al titular.
# MAIL_FROM debe ser un remitente del dominio verificado en Resend.
RESEND_API_KEY=""
MAIL_FROM="San Luca Ristorante <no-reply@sanlucaristorante.com>"

