generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// USUARIOS & AUTH
// ============================================

model User {
  id           String     @id @default(cuid())
  name         String
  email        String     @unique
  phone        String     @default("")
  birthDate    DateTime?
  passwordHash String?
  googleId     String?    @unique
  role         Role       @default(CUSTOMER)
  source       UserSource @default(WEB) // canal por el que llegó: web o whatsapp bot

  // Vínculo opcional User ↔ Staff (Fase B.2). Solo Ricardo lo usa: su User
  // ADMIN (sl_session) ligado a su Staff MANAGER (sl_staff) para auditoría
  // dual-realm. El resto de empleados no tiene User.
  staffId Int?   @unique
  staff   Staff? @relation(fields: [staffId], references: [id])

  // Aceptación de Aviso de Privacidad + T&C (LFPDPPP — evidencia para INAI).
  // Un solo timestamp cubre ambos documentos porque el checkbox de registro
  // es uno solo. Si la versión publicada cambia se prompt-ea re-aceptación.
  acceptedTermsAt      DateTime?
  acceptedTermsVersion String?   @default("1.0")

  reservations          Reservation[]          @relation("OwnedReservations")
  createdReservations   Reservation[]          @relation("CreatedReservations")
  whatsappConversations WhatsAppConversation[]
  tags                  UserTag[]
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
}

enum Role {
  CUSTOMER
  HOSTES
  ADMIN
}

enum UserSource {
  WEB
  WHATSAPP
}

// ============================================
// STAFF — empleados de operación (sistema de Comandas)
// Auth propia con PIN de 4 dígitos (bcrypt). Realm separado del modelo
// `User` (que cubre comensales web + ADMIN/HOSTES). Ver Fase 0 del plan
// de Comandas. `tenantId @default(1)` para quedar multi-tenant ready.
// ============================================

enum StaffRole {
  WAITER // Mesero
  OPERATION // Perla (hostess + caja)
  CAPTAIN // Capitán
  MANAGER // Ricardo (admin)
}

model Staff {
  id       Int @id @default(autoincrement())
  tenantId Int @default(1) // multi-tenant ready

  // Identificación
  username String @unique // ej: "luis.mesero", "perla", "ricardo"
  fullName String

  // Autenticación
  pinHash String // bcrypt del PIN (nunca PIN plano)

  role StaffRole

  // Estado
  active Boolean @default(true)

  // Telemetría
  lastLoginAt DateTime?
  lastShift   String? // "brunch" o "tarde", para reportes

  // Auditoría
  createdAt   DateTime @default(now())
  createdById Int?
  updatedAt   DateTime @updatedAt

  // Relaciones del sistema de Comandas (Fase B.1)
  comandasAsWaiter      Comanda[]             @relation("ComandaWaiter")
  comandasOpened        Comanda[]             @relation("ComandaOpener")
  comandasClosed        Comanda[]             @relation("ComandaCloser")
  itemsAdded            ComandaItem[]
  printsExecuted        ComandaPrint[]        @relation("PrintExecutor")
  printsAuthorized      ComandaPrint[]        @relation("PrintAuthorizer")
  tableChangesAuthored  ComandaTableChange[]  @relation("TableChangeAuthor")
  waiterChangesAuthored ComandaWaiterChange[] @relation("WaiterChangeAuthor")
  settingsUpdated       RestaurantSettings[]
  // Caja / POS (Fase Caja)
  cashSessionsOpened    CashSession[]         @relation("CashSessionOpener")
  cashSessionsClosed    CashSession[]         @relation("CashSessionCloser")
  paymentsReceived      ComandaPayment[]      @relation("PaymentReceiver")
  discountsAuthorized   ComandaDiscount[]     @relation("DiscountAuthorizer")
  itemTransfers         ComandaItemTransfer[] @relation("ItemTransferAuthor")
  mergesAuthored        ComandaMerge[]        @relation("MergeAuthor")
  reopensAuthored       ComandaReopen[]       @relation("ReopenAuthor")
  // Reparto de propinas (Fase Propinas)
  tipSettlementsCreated TipSettlement[]       @relation("TipSettlementCreator")
  tipSettlementRows     TipSettlementWaiter[] @relation("TipSettlementWaiter")
  waiterTipsReceived    WaiterTipSettlement[] @relation("WaiterTipSettlementWaiter") // liquidaciones donde es el mesero
  waiterTipsSettled     WaiterTipSettlement[] @relation("WaiterTipSettler") // liquidaciones que ejecutó como caja
  user                  User? // vínculo dual-realm (Ricardo). Inverso de User.staff

  @@index([tenantId, role, active])
  @@index([username])
}

// ============================================
// MENÚ
// ============================================

enum MenuTurno {
  COMIDA
  BRUNCH
}

// Carta = agrupación de categorías dentro de un turno (nivel 2 del menú).
// Ej: Comida→Clásica (COCINA), Comida→Vinos (BARRA), Brunch→Brunch (COCINA).
// `clase` reusa PrepArea: COCINA = alimentos, BARRA = bebidas.
model Carta {
  id         String         @id @default(cuid())
  name       String // "Clásica", "Autor", "Bebidas", "Postres", "Destilados", "Vinos", "Brunch"
  turno      MenuTurno
  clase      PrepArea // COCINA = alimentos, BARRA = bebidas
  position   Int?
  categories MenuCategory[]
  createdAt  DateTime       @default(now())

  @@unique([turno, name])
}

model MenuCategory {
  id        String   @id @default(cuid())
  name      String
  position  Int?
  imageUrl  String?
  cartaId   String? // FK a Carta (turno + clase). Null = sin clasificar aún.
  carta     Carta?   @relation(fields: [cartaId], references: [id])
  dishes    Dish[]
  createdAt DateTime @default(now())
}

model Dish {
  id               String            @id @default(cuid())
  name             String
  description      String?
  price            Float
  imageUrl         String?
  available        Boolean           @default(true) // "Mostrar en menú" público
  isExtra          Boolean           @default(false) // extra/especial (paquete de Ricardo); oculto del menú, lo piden meseros
  position         Int?
  categoryId       String
  category         MenuCategory      @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  reservationItems ReservationItem[] // ← platillos pre-ordenados que usan este dish
  prepArea         PrepArea? // área de preparación (Fase B). NULL = no clasificado
  comandaItems     ComandaItem[]
  createdAt        DateTime          @default(now())
}

// ============================================
// SECCIONES Y MESAS
// ============================================

model Section {
  id          String   @id @default(cuid())
  name        String   @unique // "Terraza", "Planta Alta", "Salón", "Privado"
  description String?
  isActive    Boolean  @default(true)
  tables      Table[]
  createdAt   DateTime @default(now())
}

model Table {
  id                 String        @id @default(cuid())
  number             Int // número visible: 1, 2, 3...
  capacity           Int // máximo de personas
  sectionId          String
  section            Section       @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  isActive           Boolean       @default(true)
  reservations       Reservation[] @relation("PrimaryTable")
  linkedReservations Reservation[] @relation("LinkedTable")
  thirdReservations  Reservation[] @relation("ThirdTable")
  fourthReservations Reservation[] @relation("FourthTable")
  createdAt          DateTime      @default(now())
  block              TableBlock?
  comandas           Comanda[]

  @@unique([number, sectionId])
  @@index([sectionId])
}

model TableBlock {
  id        String   @id @default(cuid())
  tableId   String   @unique
  table     Table    @relation(fields: [tableId], references: [id], onDelete: Cascade)
  note      String?
  createdAt DateTime @default(now())
}

// ============================================
// RESERVACIONES
// ============================================

model Reservation {
  id String @id @default(cuid())

  // ── Cuenta dueña de la reserva (comensal) ─────────
  userId String
  user   User   @relation("OwnedReservations", fields: [userId], references: [id], onDelete: Cascade)

  // ── Quién la creó (puede ser staff distinto del comensal) ─────────
  createdById String?
  createdBy   User?   @relation("CreatedReservations", fields: [createdById], references: [id], onDelete: SetNull)

  // ── Titular de la reserva ──────────────
  // Independiente del perfil del usuario,
  // por si reserva a nombre de otra persona.
  guestName  String
  guestPhone String

  // ── Mesa asignada ──────────────────────
  tableId       String? // mesa principal (o única)
  table         Table?  @relation("PrimaryTable", fields: [tableId], references: [id], onDelete: SetNull)
  linkedTableId String? // segunda mesa cuando se combinan dos
  linkedTable   Table?  @relation("LinkedTable", fields: [linkedTableId], references: [id], onDelete: SetNull)
  thirdTableId  String? // tercera mesa cuando se combinan tres
  thirdTable    Table?  @relation("ThirdTable", fields: [thirdTableId], references: [id], onDelete: SetNull)
  fourthTableId String? // cuarta mesa cuando se combinan cuatro
  fourthTable   Table?  @relation("FourthTable", fields: [fourthTableId], references: [id], onDelete: SetNull)

  // ── Detalles del turno ─────────────────
  date         DateTime // fecha + hora exacta
  duration     Int      @default(90) // minutos que ocupa la mesa
  guests       Int // número de comensales
  isLargeGroup Boolean  @default(false) // >15 personas: reserva área completa por día

  // ── Preferencias del cliente ───────────
  sectionPreference String? // "Terraza" | "Planta Alta" | "Salón" (no garantizada)
  occasion          String? // cumpleaños, aniversario, cena de negocios...
  notes             String? // peticiones especiales

  // ── Pre-orden de platillos ─────────────
  wantsPreOrder  Boolean @default(false) // ¿quiere agregar platillos?
  preOrderLocked Boolean @default(false) // true después de completar el pago

  // ── Pago ───────────────────────────────
  paymentStatus   PaymentStatus @default(UNPAID)
  paymentIntentId String? // ID externo (MercadoPago preferenceId)
  amountPaid      Decimal?      @db.Decimal(10, 2)
  requiresPayment Boolean       @default(false) // fecha especial con cobro
  creditUsed      Float         @default(0) // crédito aplicado a esta reserva
  expiresAt       DateTime? // expira el apartado si no se paga (PENDING_PAYMENT)
  payment         Payment?      @relation("ReservationPayment")

  // ── Check-in con QR ────────────────────
  // El QR contiene la URL: /checkin/[qrToken]
  // El staff abre esa URL y confirma la llegada.
  qrToken     String    @unique @default(cuid())
  checkedInAt DateTime? // cuándo llegó el cliente
  checkedInBy String? // userId del staff que escaneó

  // ── Estado y ciclo de vida ─────────────
  status            ReservationStatus @default(PENDING)
  confirmedAt       DateTime?
  cancelledAt       DateTime?
  cancelReason      String?
  seenAt            DateTime? // cuándo el staff la vio en el panel (null = "nueva", parpadea)
  tablesProvisional Boolean           @default(false) // bot apartó mesas por cupo; la hostess debe finalizar la combinación

  // ── Canal de origen de la reserva (independiente del user.source) ──
  source ReservationSource @default(WEB)

  // ── Platillos pre-ordenados ────────────
  items ReservationItem[]

  // ── Comanda (Fase B) — 1:1 opcional ────
  comanda Comanda?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date])
  @@index([status])
  @@index([userId])
  @@index([tableId])
  @@index([qrToken])
}

// ============================================
// PRE-ORDEN DE PLATILLOS
// Tabla puente entre Reservation y Dish.
// Se crea DESPUÉS de que la reserva existe,
// solo si wantsPreOrder = true.
// ============================================

model ReservationItem {
  id            String      @id @default(cuid())
  reservationId String
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  dishId        String
  dish          Dish        @relation(fields: [dishId], references: [id])
  quantity      Int         @default(1)
  notes         String? // ej: "sin cilantro", "término medio"
  unitPrice     Float // precio del platillo al momento de reservar

  createdAt DateTime @default(now())

  @@index([reservationId])
  @@index([dishId])
}

// ============================================
// ENUMS
// ============================================

enum ReservationStatus {
  PENDING_PAYMENT // esperando pago MP en fechas especiales (con expiresAt)
  PENDING // recién creada, esperando confirmación
  CONFIRMED // reserva confirmada
  IN_PROGRESS // cliente está en el restaurante (EN CURSO)
  DELAYED // cliente avisó retraso (RETRASO)
  CANCELLED // cancelada por cliente o admin
  COMPLETED // cliente asistió (check-in realizado)
  NO_SHOW // no se presentó
}

enum PaymentStatus {
  UNPAID // no ha pagado
  PAID // pago completado
  REFUNDED // reembolso realizado
  PARTIAL // pagó el depósito pero no los platillos
}

enum ReservationSource {
  WEB // creada desde el sitio web o panel admin
  WHATSAPP // creada por el bot via WhatsApp
}

// ============================================
// FECHAS ESPECIALES (con cobro anticipado)
// ============================================

model SpecialDate {
  id        String   @id @default(cuid())
  month     Int // 1-12
  day       Int // 1-31
  label     String // "Día de las Madres", "San Valentín"...
  amount    Float    @default(500) // monto a cobrar por reserva
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([month, day])
}

// ============================================
// PAGOS (MercadoPago)
// ============================================

model Payment {
  id             String       @id @default(cuid())
  mpPaymentId    String?      @unique // ID del pago en MP (después del cobro)
  mpPreferenceId String?      @unique // ID de la preferencia (antes del cobro)
  amount         Float
  status         String // "pending" | "approved" | "rejected" | "cancelled"
  customerEmail  String
  customerName   String
  customerPhone  String
  reservationId  String?      @unique
  reservation    Reservation? @relation("ReservationPayment", fields: [reservationId], references: [id], onDelete: SetNull)
  rawData        Json? // respuesta completa MP para debugging
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([customerEmail])
  @@index([customerPhone])
  @@index([status])
}

// ============================================
// WHATSAPP — conversaciones e historial de mensajes
// ============================================

model WhatsAppConversation {
  id        String            @id @default(cuid())
  phone     String            @unique
  userId    String?
  user      User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  messages  WhatsAppMessage[]
  tags      ConversationTag[]
  updatedAt DateTime          @updatedAt
  createdAt DateTime          @default(now())

  @@index([updatedAt])
}

model WhatsAppMessage {
  id             String               @id @default(cuid())
  conversationId String
  conversation   WhatsAppConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  direction      MessageDirection
  body           String
  messageType    String               @default("text")
  mid            String?              @unique // ID del mensaje en Meta (WhatsApp/Messenger/Instagram). Antes "waMessageId".
  plataforma     String?              @default("whatsapp") // 'whatsapp' | 'messenger' | 'instagram'
  deletedAt      DateTime? // Soft delete: cuando Meta notifica borrado. body se vacia, mensaje queda visible como "eliminado" en CRM.
  sentAt         DateTime
  createdAt      DateTime             @default(now())

  @@index([conversationId, sentAt])
  @@index([mid])
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

// ============================================
// TAGS — etiquetas reusables sobre entidades.
// Fase 1: conversaciones de WhatsApp (ConversationTag).
// Fase 2: usuarios (UserTag) + auto-tagging por reglas/LLM con el campo
// source. Ver wiki [[Conversation Tags]] y [[Auto-tagging]].
// ============================================

model Tag {
  id            String            @id @default(cuid())
  name          String            @unique
  color         String            @default("slate") // token: slate | red | amber | green | blue | violet | pink
  description   String?
  isActive      Boolean           @default(true)
  conversations ConversationTag[]
  users         UserTag[]
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([isActive])
}

model ConversationTag {
  id             String               @id @default(cuid())
  conversationId String
  conversation   WhatsAppConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  tagId          String
  tag            Tag                  @relation(fields: [tagId], references: [id], onDelete: Cascade)
  source         TagSource            @default(MANUAL)
  appliedAt      DateTime             @default(now())
  // userId del admin que aplicó · "system:cron-rules" · "system:llm" · null.
  // Sin FK formal — sobrevive a la eliminación ARCO del admin (queda como
  // string huérfano, bitácora).
  appliedById    String?

  @@unique([conversationId, tagId])
  @@index([tagId])
  @@index([conversationId])
  @@index([source])
}

// Tags sobre el usuario (perfil) — fase 2.
// Los AUTO_RULE viven aquí (atributos del cliente derivados de su historial
// de reservas). Los AUTO_LLM viven en ConversationTag (inferencias del
// contenido de la conversación).
model UserTag {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tagId       String
  tag         Tag       @relation(fields: [tagId], references: [id], onDelete: Cascade)
  source      TagSource @default(MANUAL)
  appliedAt   DateTime  @default(now())
  // userId del admin · "system:cron-rules" · "system:llm" · null.
  appliedById String?

  @@unique([userId, tagId])
  @@index([tagId])
  @@index([userId])
  @@index([source])
}

enum TagSource {
  MANUAL // aplicado por humano desde la UI
  AUTO_RULE // aplicado por el cron de reglas deterministas
  AUTO_LLM // aplicado por la clasificación semántica del LLM
}

// ============================================
// CRÉDITOS (por cancelación de reservas pagadas)
// ============================================

// ============================================
// ARCO — Registro de Solicitudes (LFPDPPP)
// Bitácora de cada solicitud de derechos ARCO
// (Acceso, Rectificación, Cancelación, Oposición).
// Causal B (cancelación desde la app) inserta aquí
// automáticamente; causales A/C/D las crea el admin.
// ============================================

model ArcoRequest {
  id                 String      @id @default(cuid())
  folio              String      @unique // "ARCO-YYYY-NNNN"
  receivedAt         DateTime    @default(now())
  channel            ArcoChannel
  rightExercised     ArcoRight
  requesterEmail     String
  requesterName      String?
  identityVerifiedAt DateTime?
  evaluationResult   String? // "Procedente" | "Improcedente: <motivo>"
  executedAt         DateTime?
  executedBy         String? // userId del admin que ejecutó
  notifiedAt         DateTime?
  status             ArcoStatus  @default(IN_PROGRESS)
  notes              String?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  @@index([receivedAt])
  @@index([status])
  @@index([requesterEmail])
}

enum ArcoChannel {
  APP
  EMAIL
}

enum ArcoRight {
  ACCESS
  RECTIFICATION
  CANCELLATION
  OPPOSITION
}

enum ArcoStatus {
  IN_PROGRESS
  COMPLETED
  REJECTED
}

model Credit {
  id                   String    @id @default(cuid())
  customerEmail        String
  customerPhone        String
  amount               Float
  used                 Boolean   @default(false)
  source               String // "cancelled_reservation"
  originReservationId  String? // reserva cancelada que originó el crédito
  appliedReservationId String? // reserva que consumió el crédito
  notes                String?
  createdAt            DateTime  @default(now())
  usedAt               DateTime?

  @@index([customerEmail, used])
  @@index([customerPhone, used])
}

// ============================================
// COMANDAS — punto de venta operativo (Fase B.1)
// Realm de Staff (sl_staff). Multi-tenant ready (tenantId @default(1)).
// FK a Table/Reservation/Dish son String (cuid); FK a Staff son Int.
// ============================================

enum ComandaStatus {
  OPEN // recién abierta, agregando items
  IN_SERVICE // items enviados a cocina/barra, atendiendo
  AWAITING_PAYMENT // mesero pidió la cuenta, esperando caja
  PARTIALLY_PAID // hay pagos aplicados pero no cubren el total (Caja)
  PAID // pagada y cerrada
  MERGED // absorbida por otra comanda (juntar cuentas)
  CANCELLED // cancelada (solo Capitán/Manager)
}

enum PrepArea {
  BARRA // bebidas
  COCINA // alimentos
  // Futuro: agregar COCINA_CALIENTE, COCINA_FRIA, PIZZAS si se requiere
  // dividir. Sin romper data existente (los valores actuales se conservan).
}

enum ComandaItemStatus {
  PENDING // agregada, NO enviada aún
  SENT // enviada a cocina/barra (impresa)
  IN_PREP // (futuro KDS) cocina la está haciendo
  READY // (futuro) cocina/barra dice listo
  DELIVERED // mesero entregó a cliente
  CANCELLED // cancelada (con motivo y autorizador)
}

enum PrintType {
  KITCHEN_BAR // ticket a barra/cocina al "Enviar"
  CUSTOMER_FINAL // ticket de cliente al pedir cuenta
  CUSTOMER_REPRINT // reimpresión autorizada por capitán
}

enum PrintTarget {
  BARRA
  COCINA
  CAJA
}

// ── Caja / POS (Fase Caja) ──────────────────
enum PaymentMethod {
  CASH // efectivo
  CARD_DEBIT // tarjeta débito
  CARD_CREDIT // tarjeta crédito
  TRANSFER // transferencia / SPEI
  // Futuro: MEAL_VOUCHER, GIFT_CARD, COURTESY (append-only, sin romper data)
}

enum CashSessionStatus {
  OPEN
  CLOSED
}

enum DiscountScope {
  BILL // descuento a la cuenta completa
  ITEM // descuento a un producto
}

enum DiscountType {
  PERCENT // value = porcentaje
  FIXED // value = monto fijo
}

model Comanda {
  id       Int @id @default(autoincrement())
  tenantId Int @default(1)

  folio String @unique // COM-2026-0001

  tableId String? // opcional: las cuentas "para llevar" / sin mesa no tienen mesa
  table   Table?  @relation(fields: [tableId], references: [id])

  // Nombre de la cuenta cuando NO hay mesa (para llevar / cuenta X): "Para llevar - Juan"
  customName String?

  reservationId String?      @unique
  reservation   Reservation? @relation(fields: [reservationId], references: [id])

  guestsActual Int

  // Mesero PRINCIPAL actual (puede cambiar por intervención del Capitán)
  waiterId Int
  waiter   Staff @relation("ComandaWaiter", fields: [waiterId], references: [id])

  // Quién abrió la comanda (auditoría inicial)
  openedById Int
  openedBy   Staff @relation("ComandaOpener", fields: [openedById], references: [id])

  // Quién la cerró (al pasar a PAID)
  closedById Int?
  closedBy   Staff? @relation("ComandaCloser", fields: [closedById], references: [id])

  status ComandaStatus @default(OPEN)

  // Totales cacheados (calculados en backend; IVA según RestaurantSettings)
  subtotal  Decimal @default(0) @db.Decimal(10, 2)
  taxAmount Decimal @default(0) @db.Decimal(10, 2)
  total     Decimal @default(0) @db.Decimal(10, 2)

  // ── Caja / cobro (Fase Caja) ──────────────
  cashSessionId Int? // sesión de caja donde se liquidó
  cashSession   CashSession? @relation(fields: [cashSessionId], references: [id])
  amountPaid    Decimal      @default(0) @db.Decimal(10, 2) // Σ pagos no voided (caché)
  tipTotal      Decimal      @default(0) @db.Decimal(10, 2) // Σ propinas (caché)
  discountTotal Decimal      @default(0) @db.Decimal(10, 2) // descuento a la cuenta (caché)
  reopenCount   Int          @default(0)

  notes String? @db.Text
  shift String? // "brunch" | "cena"

  items         ComandaItem[]
  prints        ComandaPrint[]
  tableChanges  ComandaTableChange[]
  waiterChanges ComandaWaiterChange[]
  payments      ComandaPayment[]
  discounts     ComandaDiscount[]
  reopens       ComandaReopen[]

  openedAt           DateTime  @default(now())
  closedAt           DateTime?
  cancelledAt        DateTime?
  cancelledById      Int?
  cancellationReason String?

  @@index([tenantId, status])
  @@index([tenantId, tableId, status])
  @@index([tenantId, waiterId, openedAt])
  @@index([tenantId, openedAt])
  @@index([tenantId, status, closedAt]) // corte por fecha de cobro
  @@index([tenantId, shift]) // ventas por turno
}

model ComandaItem {
  id       Int @id @default(autoincrement())
  tenantId Int @default(1)

  comandaId Int
  comanda   Comanda @relation(fields: [comandaId], references: [id], onDelete: Cascade)

  dishId String
  dish   Dish   @relation(fields: [dishId], references: [id])

  // Snapshot al agregar (el menú puede cambiar después)
  dishNameSnapshot  String
  unitPriceSnapshot Decimal  @db.Decimal(10, 2)
  prepAreaSnapshot  PrepArea

  quantity Decimal @default(1) @db.Decimal(6, 2) // permite medias/decimales (0.5, 1.5…); precio lineal = cantidad × precio

  course Int @default(1) // "tiempo" del platillo (1º, 2º, 3º…); agrupa/separa en el ticket de cocina

  modifiers          String? @db.Text
  modifiersExtraCost Decimal @default(0) @db.Decimal(10, 2)
  kitchenNotes       String? @db.Text

  status         ComandaItemStatus @default(PENDING)
  lineTotal      Decimal           @db.Decimal(10, 2)
  discountAmount Decimal           @default(0) @db.Decimal(10, 2) // descuento por producto (caché)
  discounts      ComandaDiscount[]

  addedById Int
  addedBy   Staff    @relation(fields: [addedById], references: [id])
  addedAt   DateTime @default(now())

  sentAt      DateTime?
  deliveredAt DateTime?

  cancelledById   Int?
  cancelledReason String?
  cancelledAt     DateTime?

  @@index([tenantId, comandaId, status])
  @@index([tenantId, status])
  @@index([tenantId, dishId]) // mix de producto (reporte de ventas)
}

model ComandaPrint {
  id       Int @id @default(autoincrement())
  tenantId Int @default(1)

  comandaId Int
  comanda   Comanda @relation(fields: [comandaId], references: [id], onDelete: Cascade)

  type   PrintType
  target PrintTarget

  executedById Int
  executedBy   Staff @relation("PrintExecutor", fields: [executedById], references: [id])

  authorizedById      Int?
  authorizedBy        Staff?  @relation("PrintAuthorizer", fields: [authorizedById], references: [id])
  authorizationReason String?

  // Split bills: subconjunto de items impresos en este ticket.
  splitConfig    Json? // { ticketNumber, itemIds: [...], total }
  ticketsPrinted Int   @default(1)

  status       String  @default("SUCCESS") // PENDING | SUCCESS | FAILED | RETRYING
  attemptCount Int     @default(1)
  errorMessage String?
  payload      Json? // snapshot listo-para-imprimir que consume el PrintBridge (ESC/POS)

  printedAt DateTime @default(now())

  @@index([tenantId, comandaId])
  @@index([tenantId, type])
}

model ComandaTableChange {
  id          Int      @id @default(autoincrement())
  tenantId    Int      @default(1)
  comandaId   Int
  comanda     Comanda  @relation(fields: [comandaId], references: [id], onDelete: Cascade)
  fromTableId String // scalar (Table.id) — snapshot de auditoría
  toTableId   String
  changedById Int // siempre Captain o Manager
  changedBy   Staff    @relation("TableChangeAuthor", fields: [changedById], references: [id])
  reason      String?
  changedAt   DateTime @default(now())

  @@index([tenantId, comandaId])
}

model ComandaWaiterChange {
  id           Int      @id @default(autoincrement())
  tenantId     Int      @default(1)
  comandaId    Int
  comanda      Comanda  @relation(fields: [comandaId], references: [id], onDelete: Cascade)
  fromWaiterId Int // scalar (Staff.id) — snapshot de auditoría
  toWaiterId   Int
  changedById  Int // siempre Captain o Manager
  changedBy    Staff    @relation("WaiterChangeAuthor", fields: [changedById], references: [id])
  reason       String?
  changedAt    DateTime @default(now())

  @@index([tenantId, comandaId])
}

// ============================================
// CAJA / POS — sesión de cajón, pagos, descuentos y auditoría (Fase Caja)
// Dinero SIEMPRE Decimal(10,2). Los precios incluyen IVA (ver comandaTotals).
// ============================================

model CashSession {
  id         Int     @id @default(autoincrement())
  tenantId   Int     @default(1)
  folio      String  @unique // "CAJA-2026-0001"
  registerId String? // multi-cajón ready (null = cajón único)

  status CashSessionStatus @default(OPEN)
  shift  String? // getShiftWindow(now).name

  openingFloat Decimal  @db.Decimal(10, 2) // fondo inicial
  expectedCash Decimal? @db.Decimal(10, 2) // efectivo esperado (al cerrar)
  countedCash  Decimal? @db.Decimal(10, 2) // arqueo físico
  difference   Decimal? @db.Decimal(10, 2) // counted - expected (sobra/falta)
  cutSnapshot  Json? // corte inmutable (breakdown por método)

  openedById Int
  openedBy   Staff  @relation("CashSessionOpener", fields: [openedById], references: [id])
  closedById Int?
  closedBy   Staff? @relation("CashSessionCloser", fields: [closedById], references: [id])

  notes    String?   @db.Text
  openedAt DateTime  @default(now())
  closedAt DateTime?

  payments             ComandaPayment[]
  comandas             Comanda[]
  tipSettlement        TipSettlement?
  waiterTipSettlements WaiterTipSettlement[] @relation("CashSessionWaiterTips")

  @@index([tenantId, status])
  @@index([tenantId, openedAt])
  @@index([tenantId, shift])
}

model ComandaPayment {
  id       Int @id @default(autoincrement())
  tenantId Int @default(1)

  comandaId Int
  comanda   Comanda @relation(fields: [comandaId], references: [id]) // pago nunca se borra en cascada

  cashSessionId Int
  cashSession   CashSession @relation(fields: [cashSessionId], references: [id])

  method            PaymentMethod
  amount            Decimal       @db.Decimal(10, 2) // porción del total que salda este pago
  received          Decimal?      @db.Decimal(10, 2) // efectivo entregado (solo CASH)
  changeGiven       Decimal       @default(0) @db.Decimal(10, 2)
  tip               Decimal       @default(0) @db.Decimal(10, 2) // propina (NO cuenta al total)
  reference         String? // últimos 4 / código auth / folio SPEI
  splitTicketNumber Int? // liga a ComandaPrint.splitConfig.ticketNumber

  voided       Boolean   @default(false) // revertido por reabrir cuenta
  voidedById   Int?
  voidedReason String?
  voidedAt     DateTime?

  receivedById Int
  receivedBy   Staff    @relation("PaymentReceiver", fields: [receivedById], references: [id])
  createdAt    DateTime @default(now())

  @@index([tenantId, comandaId])
  @@index([tenantId, cashSessionId, method]) // corte por sesión + método
  @@index([tenantId, createdAt])
}

model ComandaDiscount {
  id       Int @id @default(autoincrement())
  tenantId Int @default(1)

  comandaId Int
  comanda   Comanda @relation(fields: [comandaId], references: [id], onDelete: Cascade)

  scope  DiscountScope // BILL | ITEM
  itemId Int? // requerido si scope=ITEM
  item   ComandaItem?  @relation(fields: [itemId], references: [id])

  type   DiscountType // PERCENT | FIXED
  value  Decimal      @db.Decimal(10, 2) // 10 (=10%) o 50.00 (=$50)
  amount Decimal      @db.Decimal(10, 2) // monto bruto con IVA efectivamente descontado

  reason         String // obligatorio
  authorizedById Int
  authorizedBy   Staff    @relation("DiscountAuthorizer", fields: [authorizedById], references: [id])
  createdAt      DateTime @default(now())

  @@index([tenantId, comandaId])
}

model ComandaItemTransfer {
  id                Int      @id @default(autoincrement())
  tenantId          Int      @default(1)
  fromComandaId     Int
  toComandaId       Int
  dishNameSnapshot  String // snapshot (el item pudo dividirse)
  quantity          Decimal  @db.Decimal(6, 2) // puede ser fraccional (traspaso de media orden)
  lineTotalSnapshot Decimal  @db.Decimal(10, 2)
  movedById         Int
  movedBy           Staff    @relation("ItemTransferAuthor", fields: [movedById], references: [id])
  reason            String?
  movedAt           DateTime @default(now())

  @@index([tenantId, fromComandaId])
  @@index([tenantId, toComandaId])
}

model ComandaMerge {
  id                  Int      @id @default(autoincrement())
  tenantId            Int      @default(1)
  sourceComandaId     Int
  targetComandaId     Int
  sourceFolio         String
  itemCount           Int
  mergedTotalSnapshot Decimal  @db.Decimal(10, 2)
  mergedById          Int
  mergedBy            Staff    @relation("MergeAuthor", fields: [mergedById], references: [id])
  reason              String?
  mergedAt            DateTime @default(now())

  @@index([tenantId, targetComandaId])
}

model ComandaReopen {
  id             Int           @id @default(autoincrement())
  tenantId       Int           @default(1)
  comandaId      Int
  comanda        Comanda       @relation(fields: [comandaId], references: [id], onDelete: Cascade)
  previousStatus ComandaStatus
  voidedPayments Boolean       @default(false)
  reason         String
  reopenedById   Int
  reopenedBy     Staff         @relation("ReopenAuthor", fields: [reopenedById], references: [id])
  reopenedAt     DateTime      @default(now())

  @@index([tenantId, comandaId])
}

// ============================================
// REPARTO DE PROPINAS / PUNTOS (Fase Propinas)
// Un reparto por turno de caja. Las propinas viven APARTE de la caja (no entran
// al efectivo esperado). El "punto" = % sobre la venta del mesero que se descuenta
// y se reparte a áreas (barra/cocina/garroteros/encargados/caja). Editable por corte.
// ============================================

model TipSettlement {
  id            Int         @id @default(autoincrement())
  tenantId      Int         @default(1)
  cashSessionId Int         @unique // un reparto por turno
  cashSession   CashSession @relation(fields: [cashSessionId], references: [id], onDelete: Cascade)

  pointPercent     Decimal @db.Decimal(6, 3) // suma de los % de área (referencia)
  salesTotal       Decimal @db.Decimal(10, 2)
  tipsRegistered   Decimal @db.Decimal(10, 2) // propinas de tarjeta/registradas
  cashTipsDeclared Decimal @db.Decimal(10, 2) // efectivo declarado (Σ meseros)
  poolTotal        Decimal @db.Decimal(10, 2) // Σ descuentos = a repartir a áreas

  notes       String?  @db.Text
  createdById Int
  createdBy   Staff    @relation("TipSettlementCreator", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  waiters TipSettlementWaiter[]
  areas   TipSettlementArea[]

  @@index([tenantId])
}

model TipSettlementWaiter {
  id           Int           @id @default(autoincrement())
  tenantId     Int           @default(1)
  settlementId Int
  settlement   TipSettlement @relation(fields: [settlementId], references: [id], onDelete: Cascade)

  waiterId Int
  waiter   Staff @relation("TipSettlementWaiter", fields: [waiterId], references: [id])

  salesTotal       Decimal @db.Decimal(10, 2)
  tipsRegistered   Decimal @db.Decimal(10, 2)
  cashTipsDeclared Decimal @default(0) @db.Decimal(10, 2)
  pointPercent     Decimal @db.Decimal(6, 3)
  deduction        Decimal @db.Decimal(10, 2) // salesTotal × pointPercent/100
  netTip           Decimal @db.Decimal(10, 2) // (registered + cashDeclared) − deduction (puede ser negativo)

  @@index([tenantId, settlementId])
}

model TipSettlementArea {
  id           Int           @id @default(autoincrement())
  tenantId     Int           @default(1)
  settlementId Int
  settlement   TipSettlement @relation(fields: [settlementId], references: [id], onDelete: Cascade)

  name    String // "Barra", "Cocina", "Garroteros", "Encargados", "Caja"
  percent Decimal @db.Decimal(6, 3) // % sobre la venta total
  amount  Decimal @db.Decimal(10, 2)

  @@index([tenantId, settlementId])
}

enum TipSettlementDirection {
  PAY // caja PAGA al mesero (reserva digital > 7%)
  COLLECT // caja COBRA al mesero el faltante en efectivo (reserva digital < 7%)
  EVEN // reserva == 7%, sin movimiento
}

// Liquidación de propina POR MESERO dentro de un turno (Fase Propinas v2). Cada
// mesero cierra sus cuentas, llega a caja y se concilia su "reserva" (propinas de
// tarjeta + transferencia que retiene la casa) contra su "punto" (7% de su venta
// del turno). Si la reserva supera el 7%, caja le PAGA el excedente; si no alcanza,
// el mesero COMPLETA el faltante en efectivo (COLLECT). Su PIN autoriza. El corte
// del turno se bloquea hasta que todos los meseros con venta estén liquidados.
// Una liquidación por (turno, mesero).
model WaiterTipSettlement {
  id            Int         @id @default(autoincrement())
  tenantId      Int         @default(1)
  cashSessionId Int
  cashSession   CashSession @relation("CashSessionWaiterTips", fields: [cashSessionId], references: [id], onDelete: Cascade)

  waiterId Int
  waiter   Staff @relation("WaiterTipSettlementWaiter", fields: [waiterId], references: [id])

  salesTotal   Decimal @db.Decimal(10, 2) // venta del mesero en el turno (al liquidar)
  pointPercent Decimal @db.Decimal(6, 3) // % aplicado (snapshot de la póliza)
  deduction    Decimal @db.Decimal(10, 2) // salesTotal × pointPercent/100 = su punto al pool
  reserveCard  Decimal @db.Decimal(10, 2) // propinas tarjeta + transferencia retenidas por la casa
  net          Decimal @db.Decimal(10, 2) // reserveCard − deduction (positivo = se paga, negativo = se cobra)

  direction    TipSettlementDirection
  amount       Decimal                @db.Decimal(10, 2) // |net| movido (pagado al mesero o cobrado en efectivo)
  cashReceived Decimal?               @db.Decimal(10, 2) // efectivo entregado por el mesero (solo COLLECT)
  changeGiven  Decimal                @default(0) @db.Decimal(10, 2) // cambio devuelto (solo COLLECT)

  settledById Int
  settledBy   Staff    @relation("WaiterTipSettler", fields: [settledById], references: [id])
  printId     Int? // ticket de liquidación impreso (ComandaPrint), si aplica
  notes       String?  @db.Text
  createdAt   DateTime @default(now())

  @@unique([cashSessionId, waiterId]) // una liquidación por mesero por turno
  @@index([tenantId, cashSessionId])
}

// ============================================
// CONFIGURACIÓN DEL RESTAURANTE (IVA configurable, Fase B.1)
// 1 fila por tenant. El cálculo de totales la consulta.
// ============================================

model RestaurantSettings {
  id          Int      @id @default(autoincrement())
  tenantId    Int      @unique @default(1)
  taxEnabled  Boolean  @default(true)
  taxRate     Decimal  @default(0.16) @db.Decimal(5, 4)
  tipPolicy   Json? // política default de reparto de propinas: { areas: [{ name, percent }] }
  updatedAt   DateTime @updatedAt
  updatedById Int?
  updatedBy   Staff?   @relation(fields: [updatedById], references: [id])
}
